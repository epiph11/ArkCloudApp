@page "/customers"
@layout MainLayout
@inject CustomersApiClient CustomersApi
@inject NavigationManager Navigation

<PageTitle>Customers</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>Customers</h1>

        <div class="mb-3">
            <input class="form-control" placeholder="Search by name or email..."
                   @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
        </div>

        @if (_loadError is not null)
        {
            <div class="alert alert-danger">@_loadError</div>
        }
        else if (_page is null)
        {
            <p>Loading...</p>
        }
        else if (_page.Items.Count == 0)
        {
            <p>No customers found.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>First name</th>
                        <th>Last name</th>
                        <th>Email</th>
                        <th>City</th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in _page.Items)
                    {
                        <tr>
                            <td>@customer.FirstName</td>
                            <td>@customer.LastName</td>
                            <td>@customer.Email</td>
                            <td>@customer.City</td>
                            <td><a href="@($"customers/{customer.Id}")">View</a></td>
                            <td>
                                <AuthorizeView Roles="Admin" Context="adminContext">
                                    <Authorized>
                                        @if (_pendingDeleteId == customer.Id)
                                        {
                                            <button class="btn" @onclick="() => ConfirmDeleteAsync(customer.Id)">Confirm?</button>
                                            <button class="btn btn-link" @onclick="() => _pendingDeleteId = null">Cancel</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-link" @onclick="() => _pendingDeleteId = customer.Id">Delete</button>
                                        }
                                    </Authorized>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (_deleteError is not null)
            {
                <div class="alert alert-danger">@_deleteError</div>
            }

            <div class="mb-3">
                <button class="btn" disabled="@(_page.Page <= 1)" @onclick="() => ChangePageAsync(_page.Page - 1)">Previous</button>
                <span> Page @_page.Page of @Math.Max(_page.TotalPages, 1) (@_page.TotalCount total) </span>
                <button class="btn" disabled="@(_page.Page >= _page.TotalPages)" @onclick="() => ChangePageAsync(_page.Page + 1)">Next</button>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private ArkCloud.Application.DTOs.PagedResult<ArkCloud.Application.DTOs.CustomerResponse>? _page;
    private string? _loadError;
    private string? _deleteError;
    private string _search = string.Empty;
    private Guid? _pendingDeleteId;
    private int _currentPage = 1;
    private System.Threading.CancellationTokenSource? _debounce;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            _page = await CustomersApi.GetPagedAsync(search: _search, page: _currentPage, pageSize: 20);
        }
        catch (HttpRequestException ex)
        {
            _loadError = $"Could not reach the API: {ex.Message}";
        }
    }

    private async Task ChangePageAsync(int page)
    {
        _currentPage = page;
        await LoadAsync();
    }

    private async Task OnSearchKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        // Simple debounce so we don't fire a request on every keystroke.
        _debounce?.Cancel();
        _debounce = new System.Threading.CancellationTokenSource();
        var token = _debounce.Token;

        try
        {
            await Task.Delay(300, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        _currentPage = 1;
        await LoadAsync();
    }

    private async Task ConfirmDeleteAsync(Guid id)
    {
        _deleteError = null;
        _pendingDeleteId = null;

        try
        {
            await CustomersApi.DeleteAsync(id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _deleteError = ex.Message;
        }
    }
}
