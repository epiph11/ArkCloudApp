@page "/customers/{Id:guid}"
@layout MainLayout
@inject CustomersApiClient CustomersApi
@inject NavigationManager Navigation

<PageTitle>Customer details</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (_loadError is not null)
        {
            <div class="alert alert-danger">@_loadError</div>
        }
        else if (_customer is null)
        {
            <p>Loading...</p>
        }
        else
        {
            <h1>@_customer.FirstName @_customer.LastName</h1>

            <table class="table">
                <tbody>
                    <tr><th>Email</th><td>@_customer.Email</td></tr>
                    <tr><th>Street</th><td>@_customer.Street</td></tr>
                    <tr><th>City</th><td>@_customer.City</td></tr>
                    <tr><th>Country</th><td>@_customer.Country</td></tr>
                </tbody>
            </table>

            @if (_deleteError is not null)
            {
                <div class="alert alert-danger">@_deleteError</div>
            }

            <div class="mb-3">
                <a class="btn btn-primary" href="@($"customers/{_customer.Id}/edit")">Edit</a>

                <AuthorizeView Roles="Admin" Context="adminContext">
                    <Authorized>
                        @if (_confirmingDelete)
                        {
                            <button class="btn" @onclick="DeleteAsync">Confirm delete?</button>
                            <button class="btn btn-link" @onclick="() => _confirmingDelete = false">Cancel</button>
                        }
                        else
                        {
                            <button class="btn btn-link" @onclick="() => _confirmingDelete = true">Delete</button>
                        }
                    </Authorized>
                </AuthorizeView>

                <a class="btn btn-link" href="customers">Back to list</a>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ArkCloud.Application.DTOs.CustomerResponse? _customer;
    private string? _loadError;
    private string? _deleteError;
    private bool _confirmingDelete;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _customer = await CustomersApi.GetByIdAsync(Id);
            if (_customer is null)
                _loadError = "Customer not found.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _loadError = "Customer not found.";
        }
        catch (HttpRequestException ex)
        {
            _loadError = $"Could not reach the API: {ex.Message}";
        }
    }

    private async Task DeleteAsync()
    {
        _deleteError = null;

        try
        {
            await CustomersApi.DeleteAsync(Id);
            Navigation.NavigateTo("customers");
        }
        catch (Exception ex)
        {
            _deleteError = ex.Message;
            _confirmingDelete = false;
        }
    }
}
