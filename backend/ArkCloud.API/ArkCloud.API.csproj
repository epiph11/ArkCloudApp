<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>ArkCloud.API</RootNamespace>
    <UserSecretsId>arkcloud-api-secrets</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reads APPLICATIONINSIGHTS_CONNECTION_STRING (set as an App Service app setting by
         ArkCloudInfra's app-service module) automatically — no connection string in code.
         Custom Docker images don't get Azure's codeless auto-instrumentation, so this explicit
         SDK registration is required for any telemetry to reach Application Insights at all. -->
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <!-- Production secret management (Program.cs "Key Vault" section): pattern is wired up
         and activates automatically once Configuration:KeyVault:Uri is set — see README. -->
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.4.0" />
    <!-- Aligné sur ArkCloud.Infrastructure.csproj (Sprint 6 clôture, passwordless Azure) — sinon
         NU1605 "package downgrade" bloque le restore en Warning-As-Error dès que ce projet
         référence directement une version antérieure à celle exigée transitivement. -->
    <PackageReference Include="Azure.Identity" Version="1.14.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArkCloud.Application\ArkCloud.Application.csproj" />
    <ProjectReference Include="..\ArkCloud.Infrastructure\ArkCloud.Infrastructure.csproj" />
  </ItemGroup>

</Project>
