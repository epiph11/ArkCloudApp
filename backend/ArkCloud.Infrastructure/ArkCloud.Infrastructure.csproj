<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>ArkCloud.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />

    <!-- Sprint 6 — passwordless AWS (ADR-0011, scope AWS) : génère un token IAM RDS localement
         (signature SigV4, aucun appel réseau) au lieu de lire un mot de passe statique. Utilisé
         uniquement quand Database:AuthMode=AwsIam (voir InfrastructureServiceRegistration.cs) —
         sur Azure, le chemin ConnectionStrings:DefaultConnection existant reste inchangé. -->
    <PackageReference Include="AWSSDK.RDS" Version="4.0.10.1" />
    <!-- Référence directe pour forcer la résolution NuGet au-dessus de la version amenée
         transitivement par AWSSDK.RDS — CVE-2026-22611 (CWE-1286, medium, CVSS 6.3), trouvée
         par Snyk sur la PR de clôture Sprint 6, corrigée à partir de 4.0.3.3. -->
    <PackageReference Include="AWSSDK.Core" Version="4.0.3.3" />

    <!-- Sprint 6 clôture — passwordless Azure (ADR-0011, scope Azure) : DefaultAzureCredential
         génère un token Entra ID localement (Managed Identity en prod, mêmes credentials que le
         chemin Key Vault déjà utilisé côté ArkCloud.API), utilisé uniquement quand
         Database:AuthMode=AzureAd. Contrepartie exacte de AWSSDK.RDS/AWSSDK.Core au-dessus pour
         AwsIam. -->
    <PackageReference Include="Azure.Identity" Version="1.14.2" />

    <!-- Authentication: JWT generation + password hashing. -->
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.9" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.14.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArkCloud.Domain\ArkCloud.Domain.csproj" />
    <ProjectReference Include="..\ArkCloud.Application\ArkCloud.Application.csproj" />
  </ItemGroup>

</Project>
